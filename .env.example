# ---------------------------------------------------------------
# flashback — Guess the moment. Relive the memory.
# Copy to .env.local. Placeholders only: NEVER commit real secrets.
# ---------------------------------------------------------------

# --- Runtime ---------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Shows the "Try the demo" sample game (original illustrations). Set false in production.
DEMO_MODE=true
# Games and photos are deleted this many days after the last activity.
IMAGE_RETENTION_DAYS=7
# Where the SQLite database and private media live (never inside public/).
FLASHBACK_DATA_DIR=./data
# Optional: makes a personal server private. When set, creating games / uploading / importing needs this passcode
# (entered once per browser at /unlock). Joining and playing a room never needs it. Empty = anyone can create.
OWNER_PASSCODE=
# Optional: bearer secret for GET /api/cron/cleanup (scheduled cleanup on serverless hosts).
CRON_SECRET=

# --- Map (browser-safe; restrict by domain at the provider) ----
# Highest priority: full MapLibre style URL (e.g. MapTiler/Stadia/self-hosted).
# Use the literal value "local" to force the bundled offline country-outline style.
NEXT_PUBLIC_MAP_STYLE_URL=
# Convenience: a MapTiler key builds the style URL and enables reverse-geocode place labels.
NEXT_PUBLIC_MAPTILER_KEY=
# Default UI language: en (LTR, default) or he (RTL). Users can switch in the header.
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Where the map opens: "local" (default) = the player's own region, worked out on the device from the time zone, or the
# device location if that permission was already granted (never prompted, never sent to the server);
# "world" = always the neutral world view.
NEXT_PUBLIC_MAP_START=local

# --- Google Photos Picker (server-only secrets) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# 32 random bytes, base64 or hex.  e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Test-only overrides (leave unset in real deployments) ------
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_PICKER_API_BASE=
# NEXT_PUBLIC_E2E=1
