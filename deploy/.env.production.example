# Copy to .env on the VM (cp deploy/.env.production.example .env) and fill in. NEVER commit the real file.

# Your public address WITHOUT https://, e.g. flashback.example.com. Must point at the VM's IP.
DOMAIN=

# Only you can create games (everyone can still join with a room code). Pick a long passphrase. Leave empty to let anyone create.
OWNER_PASSCODE=

# Personal server: no sample game.
DEMO_MODE=false
IMAGE_RETENTION_DAYS=7

# Lets the VM's cron call the cleanup endpoint (any long random string)
CRON_SECRET=

# --- Google Photos Picker (see docs/DEPLOY-GCP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes:  openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Map (baked into the app at build time; rebuild after changing) ---
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_MAP_START=local
